# Отправка заявок на почту через Web3Forms.
# Ключ получить на web3forms.com: ввести адрес почты — ключ придёт письмом.
# Он публичный и используется прямо в браузере, поэтому префикс NEXT_PUBLIC_.
# Заявки приходят на почту аккаунта, в котором создана форма.

NEXT_PUBLIC_WEB3FORMS_KEY=

# Пароль входа в панель управления (/admin). Задайте свой.
ADMIN_PASSWORD=
